---
// A small, simple palace-arch ornament between thin gold rules. Decorative only.
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<div class={`ornament ${className}`} aria-hidden="true">
  <span class="rule"></span>
  <svg viewBox="0 0 64 24" width="80" height="30" focusable="false">
    <g fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round">
      <!-- central cusped arch -->
      <path d="M22 21 V13 Q22 8 26 6.5 Q29 5.5 32 2 Q35 5.5 38 6.5 Q42 8 42 13 V21" />
      <path d="M26.5 21 V14 Q26.5 10.5 29.5 9.5 Q31 9 32 7.5 Q33 9 34.5 9.5 Q37.5 10.5 37.5 14 V21" />
      <!-- side domes -->
      <path d="M12 21 V16 Q12 12.5 15 12 Q18 12.5 18 16 V21" />
      <path d="M46 21 V16 Q46 12.5 49 12 Q52 12.5 52 16 V21" />
      <path d="M4 21 H60" />
    </g>
    <g fill="currentColor">
      <circle cx="32" cy="1.6" r="1.1" />
      <circle cx="15" cy="11" r="0.8" />
      <circle cx="49" cy="11" r="0.8" />
    </g>
  </svg>
  <span class="rule"></span>
</div>
